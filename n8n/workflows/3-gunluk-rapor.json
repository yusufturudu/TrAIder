      "parameters": {
        "content": "## ☀️ Günlük Rapor\nHer sabah 09:00'da fiyatlar, portföy değeri ve yapay zeka özetini, günlük raporu açık olan herkese Telegram'dan gönderir.\n\nSaati değiştirmek için ilk kutuya çift tıkla.",
        "height": 220,
        "width": 380
      },
      "id": "833b144c-ea25-5245-a027-232adbcd85b6",
      "name": "Not",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "7d24b9c5-3b2e-5372-9d4d-999f90cce09b",
      "name": "Her Sabah 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRAIDER_URL }}/api/n8n/daily-report",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "9dabc519-3744-54fe-912d-56852827cd03",
      "name": "Raporu Hazırla",
