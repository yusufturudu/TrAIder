# ===== YAPAY ZEKA (birini yazman yeterli) =====
# OpenRouter (https://openrouter.ai/keys) — varsa bu kullanılır
OPENROUTER_API_KEY=sk-or-v1-buraya_yaz
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# veya Gemini (https://aistudio.google.com)
# GEMINI_API_KEY=buraya_yaz

# ===== VERİTABANI (docker compose ile kurulan PostgreSQL) =====
DB_USER=traider
DB_PASSWORD=traider
DB_NAME=traider
DATABASE_URL=postgres://traider:traider@localhost:5433/traider

# ===== n8n =====
# n8n ile TrAIder sunucusu arasındaki gizli şifre (rastgele uzun bir şey yaz)
N8N_SECRET=buraya_uzun_rastgele_bir_sifre_yaz
# Telegram botunun token'ı (@BotFather'dan alınır)
TELEGRAM_BOT_TOKEN=
# Günlük rapora internetten haber araması eklensin mi? (OpenRouter'da kredi harcar)
DAILY_REPORT_NEWS=false

# PORT=3000
